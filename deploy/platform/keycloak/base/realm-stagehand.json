{
  "realm": "stagehand",
  "enabled": true,
  "clientScopes": [
    {
      "name": "catalog:read",
      "description": "Read access to Catalog",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "catalog:write",
      "description": "Write access to Catalog",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "inventory:read",
      "description": "Read access to Inventory",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "inventory:write",
      "description": "Write access to Inventory",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    }
  ],
  "clients": [
    {
      "clientId": "catalog-client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-catalog-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "optionalClientScopes": [ "catalog:read", "catalog:write" ]
    },
    {
      "clientId": "inventory-client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-inventory-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "optionalClientScopes": [ "inventory:read", "inventory:write" ]
    }
  ]
}
