# ===== .NET build outputs =====
bin/
obj/

# ===== IDE folders / per-user files =====
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# ===== VS Code: ignore most, keep shared configs =====
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ===== Test results / coverage =====
TestResults/
coverage/
*.coverage
*.coveragexml
*.trx

# ===== Frontend (Vite + Node) =====
node_modules/
dist/
.vite/
*.tsbuildinfo

# ===== Logs =====
*.log
logs/

# ===== Local config & secrets =====
*.env
*.env.local
appsettings.Local.json
appsettings.*.Local.json

# ===== Postman =====
# Commit the collection + the value-less env template only. A real environment
# export (real URLs / any pasted tokens) must never be committed — those live
# only in your local Postman "current value" column.
postman/*.postman_environment.json
!postman/Stagehand.postman_environment.json

# ===== OS junk =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Misc tool caches =====
.tools/
artifacts/