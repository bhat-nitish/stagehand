					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{idempotencyKey}}",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{reservationsAccessToken}}",
								"type": "text"
							}
						],
						"description": "Places a reservation. Returns 201 + the new id, and the reservation starts as Pending.\n\nEVENTUAL CONSISTENCY: confirmation is NOT immediate. Until the messaging step lands (Reservations publishes ReservationRequested, Inventory consumes it and replies), a reservation stays Pending FOREVER. That is the expected result right now, not a bug.\n\nSet listingId to a real Catalog listing id before sending.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"listingId\": \"\",\n  \"quantity\": 2\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{gatewayUrl}}/v1/reservations",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"v1",
								"reservations"
							]
						}
					},
					"response": []
				},
				{
					"name": "PlaceReservation (Replay)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Idempotency replay test: hold the key stable across sends.",
									"// Seeds replayKey once, then reuses it so the 2nd+ send replays.",
									"if (!pm.environment.get('replayKey')) {",
									"    pm.environment.set('replayKey', pm.variables.replaceIn('{{$guid}}'));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{replayKey}}",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{reservationsAccessToken}}",
								"type": "text"
							}
						],
						"description": "Idempotency replay test. Send this request TWICE with the same key ({{replayKey}}): the 1st send creates a reservation (201), the 2nd replays the SAME 201 body with the SAME id -- no second reservation is created. Then run SearchReservations to confirm only one row exists. To run a fresh cycle, clear the replayKey environment variable so the pre-request seeds a new one.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"listingId\": \"\",\n  \"quantity\": 2\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{gatewayUrl}}/v1/reservations",
							"host": [
