								"stock-items",
								"{{stockItemId}}",
								"reserve"
							]
						},
						"description": "Holds stock for a specific reservation. Set reservationId to a real reservation id (or any GUID for a standalone test). Reserving twice with the SAME reservationId is a no-op - availableQuantity drops once."
					},
					"response": []
				},
				{
					"name": "ReserveStock (Replay)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Idempotency replay test: hold the key stable across sends.",
									"// Seeds replayKey once, then reuses it so the 2nd+ send replays.",
									"if (!pm.environment.get('replayKey')) {",
									"    pm.environment.set('replayKey', pm.variables.replaceIn('{{$guid}}'));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{replayKey}}",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{inventoryAccessToken}}",
								"type": "text"
							}
						],
						"description": "Idempotency replay test, two layers. Send TWICE with the same key ({{replayKey}}): the HTTP idempotency filter replays the 2nd send. Then change the Idempotency-Key but keep the SAME reservationId and send again: the request reaches the domain, but StockHold makes Reserve a no-op, so availableQuantity STILL drops only once. That second case is the one messaging depends on - a redelivered message must not double-count.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reservationId\": \"\",\n  \"quantity\": 5\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{gatewayUrl}}/v1/stock-items/{{stockItemId}}/reserve",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"v1",
								"stock-items",
								"{{stockItemId}}",
								"reserve"
							]
						}
					},
					"response": []
				},
