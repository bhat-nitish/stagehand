								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.environment.set('reservationId', pm.response.json().id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{idempotencyKey}}",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{reservationsAccessToken}}",
								"type": "text"
							}
						],
						"description": "Places a reservation. Returns 201 + id; status starts Pending.\n\nThe saga then drives it automatically: Pending -> Confirmed (stock held) or Rejected (insufficient stock / no stock item). Poll GetReservation to watch it. This is EVENTUALLY consistent - the 201 does not mean confirmed.\n\nSet listingId to a listing that has a stock item in Inventory, otherwise it will be Rejected with NoStockItemForListing.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"listingId\": \"\",\n  \"quantity\": 2\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{gatewayUrl}}/v1/reservations",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"v1",
								"reservations"
							]
						}
					},
					"response": []
				},
				{
					"name": "PlaceReservation (Replay)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Idempotency replay test: hold the key stable across sends.",
									"// Seeds replayKey once, then reuses it so the 2nd+ send replays.",
									"if (!pm.environment.get('replayKey')) {",
									"    pm.environment.set('replayKey', pm.variables.replaceIn('{{$guid}}'));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{replayKey}}",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{reservationsAccessToken}}",
								"type": "text"
							}
						],
