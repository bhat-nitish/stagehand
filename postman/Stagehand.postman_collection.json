				{
					"name": "ReserveStock (Replay)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Idempotency replay test: hold the key stable across sends.",
									"// Seeds replayKey once, then reuses it so the 2nd+ send replays.",
									"if (!pm.environment.get('replayKey')) {",
									"    pm.environment.set('replayKey', pm.variables.replaceIn('{{$guid}}'));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{replayKey}}",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{inventoryAccessToken}}",
								"type": "text"
							}
						],
						"description": "Idempotency replay test. Send this request TWICE with the same key ({{replayKey}}): the 1st send reserves 5, the 2nd is replayed (204, no extra reserve). Then run GetStockItem -> availableQuantity dropped by 5 ONCE, not twice. To run a fresh cycle, clear the replayKey environment variable so the pre-request seeds a new one.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantity\": 5\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{gatewayUrl}}/v1/stock-items/{{stockItemId}}/reserve",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"v1",
								"stock-items",
								"{{stockItemId}}",
								"reserve"
							]
						}
					},
					"response": []
				},
