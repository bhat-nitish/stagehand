{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/stagehand",
    "RequireHttpsMetadata": false,
    "ValidIssuers": [ "http://localhost:8081/realms/stagehand" ]
  },
  "ReverseProxy": {
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://localhost:8080/"
          }
        }
      }
    }
  }
}
